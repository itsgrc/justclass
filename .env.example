# Configurazione SMTP per /api/request — copiate in .env e compilate.
# Se queste variabili mancano, l'endpoint registra comunque la richiesta
# in data/requests.jsonl e risponde con successo (nessuna email inviata).

# Host del provider SMTP, es. smtp.gmail.com, smtp.sendgrid.net
SMTP_HOST=

# Porta: 587 (STARTTLS, la più comune) oppure 465 (SSL diretto)
SMTP_PORT=587

# Credenziali SMTP
SMTP_USER=
SMTP_PASS=

# Dove arriva la notifica di ogni nuova richiesta
DESK_EMAIL=private@justclass.com

# Mittente delle email inviate ai clienti (spesso uguale a SMTP_USER)
FROM_EMAIL=
FROM_NAME=JUSTCLASS

# Dashboard /api/admin/requests — password per leggere il registro delle
# richieste e cambiarne lo stato. Senza questa variabile la dashboard
# rifiuta ogni accesso (per scelta: nessuna password di default).
ADMIN_PASSWORD=

# Disponibilità dei fornitori (src/api/providers): true usa i dati
# simulati in src/api/providers/mock.ts, false chiama le API reali dei
# fornitori (richiede le rispettive credenziali, es. PRIVATEFLY_API_KEY).
USE_MOCK=true
